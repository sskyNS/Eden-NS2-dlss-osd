#include <windows.h>

1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION 2,0,0,0
    PRODUCTVERSION 2,0,0,0
    FILEFLAGSMASK 0x3fL
    FILEFLAGS 0x0L
    FILEOS 0x40004L
    FILETYPE 0x1L
    FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName", "Eden Launcher"
            VALUE "FileDescription", "Eden NS2 Launcher"
            VALUE "FileVersion", "2.0.0.0"
            VALUE "InternalName", "EdenLauncher"
            VALUE "OriginalFilename", "EdenLauncher.exe"
            VALUE "ProductName", "Eden Launcher"
            VALUE "ProductVersion", "2.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
